# MongoDB Connection URI (Local MongoDB or Atlas cluster)
MONGODB_URI=mongodb://localhost:27017/
# Explicit database name to isolate from other databases on the same cluster
MONGODB_DB_NAME=Kharcha

# JWT Secret for guest session cookies (minimum 32 characters recommended)
JWT_SECRET=kharcha-super-secure-jwt-secret-key-32chars-min

# Dynamic LLM Provider configuration ('groq' | 'gemini')
LLM_PROVIDER=groq

# Groq API Configuration 
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Fallback Gemini API (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash